# Offline mode needs no Sanity account or token.
HEARTH_DATA_MODE=offline

# Set these before connecting your own Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=production
HEARTH_STUDIO_ORIGIN=http://localhost:3333

# Optional browser-test destination. Defaults to http://localhost:3333.
# HEARTH_TEST_URL=http://localhost:3333

# Only needed if the Studio and API are served from different origins.
# This does not grant CORS access on either service.
# NEXT_PUBLIC_HEARTH_API_ORIGIN=https://YOUR_APPLICATION_ORIGIN

# No write token is needed for public content reads.
# Staff requests use the signed-in Sanity session.
# Seed/deploy scripts can use the existing CLI session through --with-user-token.
